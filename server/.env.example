# ==============================================================================
# CampusFix Server Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Port the Express server listens on (defaults to 5000 if not set)
PORT=5000

# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/campusfix?retryWrites=true&w=majority

# Secret key used for signing and verifying JWT authentication tokens
# In production, use a cryptographically strong, random string (e.g., openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_here

# Allowed frontend origins for CORS (comma-separated list for multiple URLs)
# In local development: http://localhost:5173
# In production: https://<your-deployed-frontend-domain>
CLIENT_URL=http://localhost:5173

# Application Environment Mode ('development' | 'production')
NODE_ENV=development
